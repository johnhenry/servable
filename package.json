{
  "name": "@johnhenry/servable",
  "version": "0.0.0",
  "description": "Declaratively describe an HTTP server using JSX -- a small closed set of primitives, a Fetch-API dispatcher, and adapters for Node/Deno/Bun/Cloudflare.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/johnhenry/servable.git"
  },
  "homepage": "https://opensource.johnhenry.me/servable/",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18.19"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/src/jsx-runtime.d.ts",
      "default": "./dist/src/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/src/jsx-dev-runtime.d.ts",
      "default": "./dist/src/jsx-dev-runtime.js"
    },
    "./adapters/node": {
      "types": "./dist/adapters/node.d.ts",
      "default": "./dist/adapters/node.js"
    },
    "./adapters/deno": {
      "types": "./dist/adapters/deno.d.ts",
      "default": "./dist/adapters/deno.js"
    },
    "./adapters/bun": {
      "types": "./dist/adapters/bun.d.ts",
      "default": "./dist/adapters/bun.js"
    },
    "./adapters/cloudflare": {
      "types": "./dist/adapters/cloudflare.d.ts",
      "default": "./dist/adapters/cloudflare.js"
    }
  },
  "files": [
    "dist/src",
    "dist/adapters",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test scripts/run-tests.mjs",
    "coverage": "node --test --experimental-test-coverage scripts/run-tests.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jsx",
    "http",
    "router",
    "server",
    "fetch"
  ],
  "author": "John Henry",
  "dependencies": {
    "glob": "^13.0.6",
    "marked": "^18.0.13",
    "urlpattern-polyfill": "^10.0.0"
  },
  "peerDependencies": {
    "@johnhenry/fileable": ">=0.0.0",
    "@johnhenry/leserve": ">=0.0.0"
  },
  "peerDependenciesMeta": {
    "@johnhenry/fileable": {
      "optional": true
    },
    "@johnhenry/leserve": {
      "optional": true
    }
  },
  "devDependencies": {
    "@johnhenry/leserve": "^0.0.0",
    "@johnhenry/fileable": "^0.0.1",
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2",
    "@johnhenry/packfile": "file:../packfile"
  }
}
